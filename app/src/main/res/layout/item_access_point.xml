<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="14dp"
    android:paddingHorizontal="16dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- 信号图标 -->
    <ImageView
        android:id="@+id/iv_signal"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_signal_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- SSID名称 -->
    <TextView
        android:id="@+id/tv_ssid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="WiFi Network"
        android:textColor="@color/black"
        android:textSize="17sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/iv_signal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_rssi" />

    <!-- RSSI信号强度 -->
    <TextView
        android:id="@+id/tv_rssi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="-65 dBm"
        android:textColor="#888888"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/tv_score"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 分数展示 (使用淡蓝色字体) -->
    <TextView
        android:id="@+id/tv_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="--"
        android:textColor="@color/pale_blue"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/iv_expand"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 展开按钮 (默认向下图标) -->
    <ImageView
        android:id="@+id/iv_expand"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_expand_more"
        android:contentDescription="展开"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 展开的内容: Reason -->
    <TextView
        android:id="@+id/tv_reason"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:background="#F8F9FA"
        android:text="Reason text goes here..."
        android:textColor="#444444"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_ssid"
        app:layout_constraintStart_toStartOf="@id/tv_ssid"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>